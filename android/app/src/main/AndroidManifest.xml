<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FR-L902: live QR camera scan for an eSIM activation code
         (mobile_scanner). Denial is a normal state: the other three
         input sources (gallery, clipboard, manual) stay available. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- FR-L910: a removable eSIM adapter over a USB CCID smart-card
         reader. No special permission beyond unprivileged UsbManager
         (docs/Rules.md: never WRITE_EMBEDDED_SUBSCRIPTIONS or similar).
         required=false: a phone with no USB host mode can still install
         and simply never sees a reader (confirmed real-device shape via
         android.hardware.usb.host, DECISIONS.md 2026-11-21). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:label="Triptel"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- ShurjoPay hand-back: backend MOBILE_APP_RETURN_SCHEME
                 (triptel://payment-callback?order=...|payment=failed). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="triptel" />
            </intent-filter>
            <!-- FR-007: incoming https://triptel.co/track/<token> and
                 https://beta.triptel.co/track/<token> links. Best-effort
                 (no autoVerify): the backend has no /.well-known/assetlinks.json
                 yet, so Android can't auto-verify app ownership of the domain
                 and will offer a disambiguation chooser rather than opening
                 this app directly. See claude-progress.md "Blocked on backend" #7. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="triptel.co" android:pathPrefix="/track" />
                <data android:scheme="https" android:host="beta.triptel.co" android:pathPrefix="/track" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <!-- FR-L906: SGP.22's lpa: deep-link scheme, handled by any
             installed LPA/eSIM-manager app (EasyEUICC, 9eSIM, JMP SIM
             Manager, ...). Without this, launchUrl/canLaunchUrl can't
             see a real handler on Android 11+ package visibility. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lpa" />
        </intent>
    </queries>
</manifest>
